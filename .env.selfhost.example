# Copy to .env.selfhost and fill in. NEVER commit the real file.

# --- Database (self-hosted Postgres) ---
POSTGRES_USER=procalling
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=procalling

# --- Auth ---
# Generate a long random secret:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_long_random_secret
JWT_EXPIRES_IN=7d

# --- CORS ---
# The URL you open the app at. For IP-only use http://YOUR_SERVER_IP
# (add your domain later, comma-separated). Same-origin calls work regardless.
CORS_ORIGINS=http://YOUR_SERVER_IP

# --- Billing (optional; leave blank to keep online payments disabled) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
