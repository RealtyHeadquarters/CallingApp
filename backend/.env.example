# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins (web CRM, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ────────────────────────────────────────────
# Matches docker-compose.yml defaults. Change for production.
DATABASE_URL=postgresql://callingapp:callingapp@localhost:5432/callingapp?schema=public

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Telephony webhooks (future cloud provider) ──────────
# Shared secret the provider signs webhook payloads with.
TELEPHONY_WEBHOOK_SECRET=change-me-webhook-secret
